#include <stdio.h>

int main() {
    int i, n;
    int burst[20], wait[20], turn[20];
    float w = 0, t = 0;

    printf("Enter the number of processes: ");
    scanf("%d", &n);

    printf("Enter the burst time for each process:\n");
    for(i = 0; i < n; i++) {
        printf("P%d: ", i + 1);
        scanf("%d", &burst[i]);
    }

    wait[0] = 0;
    for(i = 1; i < n; i++)
        wait[i] = burst[i - 1] + wait[i - 1];

    for(i = 0; i < n; i++)
        turn[i] = burst[i] + wait[i];

    printf("\nGantt Chart:\n|");
    for(i = 0; i < n; i++)
        printf(" P%d |", i + 1);

    printf("\n0");
    for(i = 0; i < n; i++)
        printf("    %d", turn[i]);

    for(i = 0; i < n; i++) {
        w += wait[i];
        t += turn[i];
    }

    printf("\n\nAverage Waiting Time: %.2f", w / n);
    printf("\nAverage Turnaround Time: %.2f\n", t / n);

    return 0;
}
