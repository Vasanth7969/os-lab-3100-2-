#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/shm.h>
#include <sys/ipc.h>
#include <sys/wait.h>

int main() {
    int shmid, i;
    char *shmptr;

    // Create shared memory
    shmid = shmget(2041, 32, 0666 | IPC_CREAT);
    if (shmid < 0) {
        perror("shmget failed");
        exit(1);
    }

    // Fork process
    pid_t child = fork();

    if (child < 0) {
        perror("fork failed");
        exit(1);
    }

    if (child == 0) {
        // CHILD PROCESS - Reading
        sleep(1);  // Ensure parent writes first

        shmptr = shmat(shmid, NULL, 0);
        if (shmptr == (char *) -1) {
            perror("shmat failed");
            exit(1);
        }

        printf("\nCHILD PROCESS READING:\n");
        for (i = 0; i < 10; i++)
            putchar(shmptr[i]);

        printf("\n");

        shmdt(shmptr);
        exit(0);
    }
    else {
        // PARENT PROCESS - Writing
        shmptr = shmat(shmid, NULL, 0);
        if (shmptr == (char *) -1) {
            perror("shmat failed");
            exit(1);
        }

        printf("\nPARENT PROCESS WRITING:\n");
        for (i = 0; i < 10; i++) {
            shmptr[i] = 'A' + i;
            putchar(shmptr[i]);
        }

        shmptr[10] = '\0';  // Null-terminate string
        printf("\n");

        wait(NULL);

        shmdt(shmptr);
        shmctl(shmid, IPC_RMID, NULL);  // Remove shared memory
    }

    return 0;
}
